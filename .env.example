# Copia a .env en el servidor y rellena. NUNCA subas .env al repo.
# Hace que "docker compose ..." use el compose de preproducción sin -f
COMPOSE_FILE=docker-compose.prod.yml

APP_PORT=8080

DB_NAME=micuadra
DB_USER=micuadra
DB_PASSWORD=cambia-esto

DATOS_DEMO=true

# Heap máx. 384 MB (el contenedor tiene 640 MB en total)
JAVA_OPTS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC
